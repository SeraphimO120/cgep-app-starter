      {
        "uuid": "e7ff722d-05bd-4b4f-9840-823e6063ea19",
        "type": "service",
        "title": "Acme Health Patient Intake API",
        "description": "The cgep-app-starter Patient Intake API (API Gateway HTTP API, Lambda, DynamoDB, S3) deployed in us-east-1, wrapped with a customer-managed KMS key, an Object Lock evidence vault, a multi-region CloudTrail trail, OIDC-based CI identities, and a GitHub Actions gate that plans, checks five HIPAA Rego policies, applies on merge to main, signs evidence with Cosign, and uploads it to the vault. Continuous monitoring: an AWS Config recorder with eight managed rules that mirror the Rego gate, EventBridge rules that alert on non-compliance and on control-relevant changes made outside the pipeline, and a nightly pipeline run that checks for drift and runs eleven live control tests.",
        "purpose": "Receive patient intake submissions (PHI) and keep the infrastructure that stores them audit-defensible under the HIPAA Security Rule.",
        "props": [
          {
            "name": "primary-framework",
            "value": "HIPAA Security Rule (45 CFR 164 Subpart C)"
          },
          {
            "name": "repository",
            "value": "https://github.com/SeraphimO120/cgep-app-starter"
          },
          {
            "name": "aws-region",
            "value": "us-east-1"
          }
        ],
        "responsible-roles": [
          {
            "role-id": "provider",
